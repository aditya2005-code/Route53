# ==============================================================================
# Route 53 — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Use real, high-entropy secrets in your production deployment dashboard
# (e.g. Render, Vercel, Railway, AWS ECS). Never commit actual production values.

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=production

# Database Connection (Managed PostgreSQL)
# Example: postgresql://route53_user:mypassword@dpg-xxxxxx.oregon-postgres.render.com/route53_db
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Authentication & Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<GENERATE_64_CHAR_HEX_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated public frontend domain and aliases)
# Example: https://route53-beryl.vercel.app,https://route53.yourdomain.com
ALLOWED_ORIGINS=https://route53-beryl.vercel.app,https://<YOUR_FRONTEND_DOMAIN>

# OpenAI Integration (DNS Troubleshooter)
# Optional: The built-in deterministic heuristic engine operates if key is omitted
OPENAI_API_KEY=sk-proj-<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o

# Rate Limiting & Operational Flags
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=20
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js 16)
# ------------------------------------------------------------------------------
# Public Backend API URL (Bakes into client bundle at Next.js build time)
# Example: https://route53-backend-2vlc.onrender.com
NEXT_PUBLIC_API_URL=https://<YOUR_BACKEND_DOMAIN>
