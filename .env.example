# ==============================================================================
# Route53 - Environment Configuration Example
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=route53
POSTGRES_PASSWORD=route53pass
POSTGRES_DB=route53_db
DATABASE_URL=postgresql://route53:route53pass@localhost:5432/route53_db

# Security & Authentication (JWT)
JWT_SECRET_KEY=generate_a_secure_random_hex_string_64_characters_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI Integration (DNS Troubleshooter)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

